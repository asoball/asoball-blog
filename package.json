{
  "name": "asoball-blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint scripts packages apps tests --no-error-on-unmatched-pattern && pnpm format:check",
    "format": "prettier --write scripts packages apps tests *.json *.mjs *.yaml *.ts",
    "format:check": "prettier --check scripts packages apps tests *.json *.mjs *.yaml *.ts",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose up -d --wait --wait-timeout 120",
    "db:status": "docker compose ps",
    "setup:local": "tsx scripts/setup-local.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "dev:cms": "pnpm --filter cms dev",
    "test:integration": "tsx scripts/integration.ts",
    "test:publishing": "tsx scripts/publishing-integration.ts",
    "publishing:worker": "tsx scripts/publisher.ts",
    "cloud:build": "tsx scripts/cloud-build.ts",
    "preview:static": "tsx scripts/serve-static.ts",
    "publishing:request": "tsx scripts/request-publish.ts",
    "publishing:once": "tsx scripts/publisher.ts --once",
    "test:backup": "tsx scripts/backup-integration.ts",
    "rollback": "tsx scripts/rollback.ts",
    "test:queue": "tsx scripts/queue-integration.ts",
    "test:lighthouse": "tsx scripts/lighthouse.ts",
    "backup": "tsx scripts/backup.ts",
    "preview:release": "tsx scripts/serve-release.ts",
    "seed:local": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@asoball/content-contract": "workspace:*",
    "@asoball/publishing": "workspace:*",
    "@axe-core/playwright": "4.11.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@google-cloud/storage": "8.4.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "mongodb": "6.20.0",
    "payload": "3.92.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "proxy-agent": "8.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
