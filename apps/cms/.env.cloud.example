# Copy to ignored .local/cloud.env; never commit actual values.
DEPLOYMENT_ENV=cloud
DATABASE_URI=mongodb+srv://ENCODED_USER:ENCODED_PASSWORD@CLUSTER.mongodb.net/asoball_blog_prod?retryWrites=true&w=majority&authSource=admin&tls=true
# Optional cross-check against the database name inside DATABASE_URI
DATABASE_NAME=asoball_blog_prod
PAYLOAD_SECRET=<32-plus-random-characters-from-Secret-Manager>
MEDIA_STORAGE=gcs
GCS_BUCKET=replace-private-media-bucket
CMS_URL=https://replace-cms.run.app
SITE_URL=https://replace-site.web.app
BOOTSTRAP_EMAIL=replace-admin@example.com
BOOTSTRAP_CREDENTIAL_FILE=.local/cloud-admin.json
