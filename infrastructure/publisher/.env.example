# Copy to ignored .local/cloud-publisher.env for offline --plan only.
DATABASE_URI=mongodb+srv://ENCODED_USER:ENCODED_PASSWORD@CLUSTER.mongodb.net/asoball_blog_prod?retryWrites=true&w=majority&authSource=admin&tls=true
MEDIA_STORAGE=gcs
GCS_BUCKET=replace-private-media-bucket
CLOUD_PROJECT_ID=asoball
CLOUD_REGION=asia-east1
CLOUD_BUILD_TRIGGER=replace-trigger-id
CLOUD_SOURCE_SHA=0000000000000000000000000000000000000000
CLOUD_SNAPSHOT_BUCKET=replace-private-snapshots
CLOUD_CANDIDATE_BUCKET=replace-private-candidates
FIREBASE_SITE_ID=asoball
SITE_URL=https://asoball.web.app
CLOUD_PUBLISH_ENABLED=false
